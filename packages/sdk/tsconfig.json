{
  "compilerOptions": {
    "target":            "ES2020",
    "lib":               ["ES2020", "DOM"],
    "module":            "ESNext",
    "moduleResolution":  "bundler",
    "declaration":       true,
    "declarationMap":    true,
    "sourceMap":         true,
    "strict":            true,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "resolveJsonModule": true,
    "jsx":               "react-jsx"
  },
  "include":  ["src"],
  "exclude":  ["node_modules", "dist"]
}
