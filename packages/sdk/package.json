{
  "name": "@ciphercredit/sdk",
  "version": "0.1.0",
  "description": "Privacy-preserving DeFi credit scoring SDK powered by Fhenix CoFHE — verify credit tiers, check approvals, and read loan state without touching encrypted data.",
  "author": "CipherCredit",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.mjs",
      "require": "./dist/index.js",
      "types":   "./dist/index.d.ts"
    },
    "./react": {
      "import":  "./dist/react/index.mjs",
      "require": "./dist/react/index.js",
      "types":   "./dist/react/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build":      "tsup src/index.ts src/react/index.ts --format cjs,esm --dts --clean",
    "dev":        "tsup src/index.ts src/react/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "wagmi": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "wagmi": { "optional": true }
  },
  "devDependencies": {
    "tsup":      "^8.0.0",
    "typescript": "^5.3.0",
    "react":     "^18.0.0",
    "wagmi":     "^2.0.0"
  },
  "keywords": [
    "fhe", "fhenix", "cofhe", "defi", "credit", "privacy",
    "web3", "ethereum", "arbitrum", "lending", "ciphercredit"
  ],
  "repository": {
    "type": "git",
    "url":  "https://github.com/your-org/ciphercredit"
  }
}
